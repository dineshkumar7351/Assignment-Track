{
  "name": "smart-assignment-tracker",
  "version": "1.0.0",
  "description": "Smart Assignment Tracker - Fullstack Academic Management Platform",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"node server/server.js\" \"npm run dev --prefix client\"",
    "dev:web": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"node server/server.js\" \"npm run dev --prefix client\"",
    "dev:expo": "concurrently -n \"SERVER,EXPO\" -c \"blue,magenta\" \"node server/server.js\" \"expo start --web\"",
    "start": "node server/server.js",
    "client": "npm run dev --prefix client",
    "expo": "expo start",
    "expo:web": "expo start --web",
    "expo:android": "expo start --android",
    "expo:ios": "expo start --ios",
    "mobile": "expo start",
    "build": "node build.js",
    "vercel-build": "node build.js",
    "seed:admin": "node server/scripts/seedAdmin.js",
    "seed:academic": "node server/scripts/seedAcademicData.js"
  },
  "keywords": [
    "academic",
    "assignment-tracker",
    "react",
    "express",
    "mongodb"
  ],
  "license": "ISC",
  "dependencies": {
    "@clerk/express": "^2.1.66",
    "@expo/metro-runtime": "^57.0.16",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "expo": "~57.0.26",
    "expo-status-bar": "^57.0.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.2",
    "mongoose": "^8.9.5",
    "multer": "^2.3.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5"
  }
}
